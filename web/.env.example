# ===== Webアプリ設定（コピーして .env.local にする。Vercelでは Environment Variables に設定） =====
DATABASE_URL=postgresql://app:app@localhost:54329/clips
# Supabase等で証明書エラーになる場合のみ no-verify
DATABASE_SSL=

# Twitch Developer Console で作成したアプリのキー（サーバー側のみで使用）
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# サーバーレスワーカー（worker/ を Vercel にデプロイしたもの）のURLと共有シークレット。
# 空なら呼び出さない（自分のPCなどで python worker.py を常駐させる構成）
WORKER_URL=
WORKER_SECRET=

# 不正利用対策
RATE_LIMIT_PER_HOUR=10
MAX_CLIP_SECONDS=90
# 月の文字起こしコスト上限（USD）。超えたら新規受付を停止。0で無制限
MONTHLY_BUDGET_USD=10
# 受付時の見積もり単価（USD/分）。Groq無料枠・自前Whisperなら0
TRANSCRIBE_PRICE_PER_MINUTE_USD=0
# IPハッシュ用のソルト（ランダムな長い文字列にする）
IP_HASH_SALT=

# 削除依頼の窓口（フォームURLや mailto:）。設定するとフッターに表示
NEXT_PUBLIC_CONTACT_URL=
