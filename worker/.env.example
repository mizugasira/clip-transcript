# ===== ワーカー設定 =====
# ローカル: コピーして .env にする / Vercel: プロジェクトの Environment Variables に設定する
DATABASE_URL=postgresql://app:app@localhost:54329/clips
# Supabase等で証明書検証付きSSLを使う場合: require / verify-full
DATABASE_SSLMODE=

# 音声取得方式: ytdlp（方式B）
AUDIO_FETCHER=ytdlp
# 音声抽出: auto（ffmpegがあれば音声だけ抽出、無ければ動画のまま送る） / ffmpeg / none
AUDIO_EXTRACT=auto

# 文字起こしエンジン:
#   groq           … Groq の Whisper（無料枠あり。無料構成の既定）
#   openai         … OpenAI の whisper-1（有料）
#   faster_whisper … 自前のWhisper（自分のPCで動かす場合。requirements-local-whisper.txt が必要）
TRANSCRIBER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# 接続先を変える場合のみ（groq の既定は https://api.groq.com/openai/v1）
OPENAI_BASE_URL=
# 空なら既定（groq: whisper-large-v3-turbo / openai: whisper-1 / faster_whisper: small）
TRANSCRIBE_MODEL=
# 空=自動判定。ja に固定したい場合は ja
TRANSCRIBE_LANGUAGE=
# 自動判定の確信度が低いとき使う言語（faster_whisper のみ有効）
PREFER_LANGUAGE=ja
# 固有名詞などのヒント（任意）
TRANSCRIBE_PROMPT=
# コスト記録用の単価（USD/分）。空なら既定（groq/faster_whisper: 0, openai: 0.006）
TRANSCRIBE_PRICE_PER_MINUTE_USD=

MAX_CLIP_SECONDS=90
# 文字起こしAPIに送れるファイルの上限（MB）
MAX_UPLOAD_MB=25

# --- サーバーレス（Vercel）で動かす場合 ---
# Web側の WORKER_SECRET と同じ値（長いランダム文字列）
WORKER_SECRET=
# 1回の呼び出しで処理を続ける秒数の目安（Vercel Hobby の上限300秒より短く）
DRAIN_TIME_BUDGET_SEC=200
# 処理中のまま止まったジョブを失敗扱いにする分数（Vercelでは6程度）
STALE_JOB_MINUTES=6

# --- 常駐ワーカー（python worker.py）で動かす場合 ---
POLL_INTERVAL_SEC=2

# faster_whisper 用
FW_DEVICE=auto
FW_COMPUTE_TYPE=int8

# ffmpeg のパス（未指定なら PATH → imageio-ffmpeg の同梱版の順で探す）
FFMPEG_PATH=
